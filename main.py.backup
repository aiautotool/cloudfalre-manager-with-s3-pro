        self.error_entry.grid(row=0, column=4, padx=2)

        self.btn_group = ctk.CTkFrame(self.bucket_frame, fg_color="transparent")
        self.btn_group.grid(row=3, column=0, columnspan=2, padx=20, pady=10, sticky="ew")
        
        self.create_bucket_btn = ctk.CTkButton(self.btn_group, text="Apply Web & Policy", command=self.handle_s3_creation, fg_color="green", hover_color="#006400", width=150)
        self.create_bucket_btn.pack(side="left", padx=5)
        self.delete_bucket_btn = ctk.CTkButton(self.btn_group, text="Delete Bucket", command=self.delete_bucket_action, fg_color="#C0392B", hover_color="#962D22", width=120)
        self.delete_bucket_btn.pack(side="left", padx=5)

        # Endpoint strip
        self.endpoint_frame = ctk.CTkFrame(self.bucket_frame, fg_color="transparent")
